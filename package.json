{
  "name": "balanced-parens-service",
  "version": "1.0.0",
  "description": "固定对数平衡括号序列的计数 / 排名 / 反排名 / 前缀 / 分页后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "serve": "npm run build && node dist/server.js",
    "cli": "node --experimental-strip-types src/cli.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
